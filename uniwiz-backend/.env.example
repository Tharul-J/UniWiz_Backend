# UniWiz Backend Environment Configuration
# Copy this file to .env and update with your actual credentials

# Database Configuration
DB_HOST=localhost
DB_NAME=uniwiz_db
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@uniwiz.com
MAIL_FROM_NAME=UniWiz

# Stripe Payment Gateway (Optional)
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Security
SESSION_LIFETIME=120
JWT_SECRET=your-jwt-secret-key-here

# File Upload Settings
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_ENABLED=true
LOG_LEVEL=info
LOG_PATH=logs/app.log

# Job Posting Settings
MAX_ACTIVE_JOBS_PER_PUBLISHER=50
JOB_AUTO_EXPIRE_DAYS=90
FEATURED_JOB_DURATION=30

# Notifications
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_ADMIN_NOTIFICATIONS=true
NOTIFICATION_BATCH_SIZE=50

# Admin Contact
ADMIN_EMAIL=admin@uniwiz.com
SUPPORT_EMAIL=support@uniwiz.com

# Backup and Maintenance
BACKUP_ENABLED=false
MAINTENANCE_MODE=false
